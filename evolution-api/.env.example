# ── Postgres (bundled container — used to build DATABASE_CONNECTION_URI in docker-compose.yml) ──
POSTGRES_USER=evolution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=evolution_db

# ── Port on the host ──
EVOLUTION_PORT=8080

# ── Server ──
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
# Public URL where THIS container is reachable (used in generated media/webhook links).
# Use your ngrok/deployed URL here once you expose it, not just localhost.
SERVER_URL=http://localhost:8080

# ── Database (provider only — connection URI is auto-built in docker-compose.yml) ──
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# ── Cache (Redis URI is auto-built in docker-compose.yml) ──
CACHE_REDIS_ENABLED=true
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=true
CACHE_LOCAL_ENABLED=false

# ── Auth — the master key every API call and the Manager UI must send back to Evolution API ──
# Generate a real random value before running this for real, e.g.: openssl rand -hex 32
AUTHENTICATION_API_KEY=change-me-to-a-long-random-string
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# ── Webhooks: leave disabled here. Once apps/gateway has an endpoint to receive
# WhatsApp events from Evolution API, set the webhook PER INSTANCE via the
# Evolution API/Manager UI instead of globally here (each vendor's instance
# should point at the same gateway endpoint, which resolves business_id from
# the instance name in the payload). ──
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_REQUEST_TIMEOUT_MS=60000
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
