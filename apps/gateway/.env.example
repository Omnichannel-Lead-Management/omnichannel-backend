PORT=3000
NODE_ENV=development
# Heroku Postgres injects this automatically once the add-on is provisioned
# (heroku addons:create heroku-postgresql, then heroku config:get DATABASE_URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/messaging
# Set to "true" to force SSL locally, or "false" to disable it in production.
# Defaults: SSL required when NODE_ENV=production, off otherwise.
# DATABASE_SSL=true
TELEGRAM_BOT_TOKEN=your_bot_token
WHATSAPP_ACCESS_TOKEN=your_token
ROUTING_SERVICE_URL=http://localhost:3001
