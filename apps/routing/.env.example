PORT=3001
NODE_ENV=development

# --- Gemini via Vertex AI (preferred) -------------------------------------
# Authenticates with Application Default Credentials: the VM's attached
# service account in production, or `gcloud auth application-default login`
# locally. No API key needed.
GOOGLE_CLOUD_PROJECT=omnichannel-vertex
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Fallback: Gemini Developer API ---------------------------------------
# Used only when GOOGLE_CLOUD_PROJECT is unset. Force either backend with
# GOOGLE_GENAI_USE_VERTEXAI=true|false.
# GEMINI_API_KEY=your_api_key
