PORT=3004
NODE_ENV=development
DATABASE_PATH=../../data/notifications.db
# SMTP values are required when NOTIFICATIONS_ENABLED is omitted or true.
NOTIFICATIONS_ENABLED=false
# Public dashboard origin for email buttons; omit to suppress buttons.
DASHBOARD_BASE_URL=
# Match appointment service's business-local offset (minutes east of UTC).
BUSINESS_UTC_OFFSET_MINUTES=0
SMTP_HOST=smtp.example.com
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=notifications@example.com
