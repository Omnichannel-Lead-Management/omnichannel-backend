#!/usr/bin/env bash
# Strip Cursor/AI attribution trailers Cursor may inject into commit messages.
msg_file="$1"
[ -f "$msg_file" ] || exit 0
sed -i \
  -e '/^Co-authored-by:.*[Cc]ursor/d' \
  -e '/^Made-with:.*[Cc]ursor/d' \
  -e '/^Co-authored-by: Cursor <cursoragent@cursor.com>/d' \
  "$msg_file"
