# Required for AI routing
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional: Telegram single-bot mode (or connect per-business via API)
TELEGRAM_BOT_TOKEN=

# Public HTTPS domain (Cloudflare → this server)
PUBLIC_BASE_URL=https://cache.us.kg

# Browser origins allowed by gateway CORS / WebSocket
CORS_ALLOWED_ORIGINS=https://cache.us.kg,http://cache.us.kg

AGENT_AUTH_MODE=none
