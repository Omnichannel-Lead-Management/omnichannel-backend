# Required for AI routing — Gemini through Vertex AI.
# Auth comes from the host VM's attached service account (Application Default
# Credentials), so no API key is stored here. The VM needs the Vertex AI User
# role and the cloud-platform scope.
GOOGLE_CLOUD_PROJECT=omnichannel-vertex
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Containers reach the GCE metadata server by IP, avoiding a DNS lookup for
# metadata.google.internal that Docker's resolver may not answer.
GCE_METADATA_HOST=169.254.169.254

# Fallback only, when not running on GCP. Leave unset to use Vertex AI.
# GEMINI_API_KEY=

# Optional: Telegram single-bot mode (or connect per-business via API)
TELEGRAM_BOT_TOKEN=

# Public HTTPS domain (Cloudflare → this server)
PUBLIC_BASE_URL=https://cache.us.kg

# Browser origins allowed by gateway CORS / WebSocket
CORS_ALLOWED_ORIGINS=https://cache.us.kg,http://cache.us.kg

AGENT_AUTH_MODE=none

# Origin TLS certs for the edge (origin.crt / origin.key), mounted read-only.
# Must live OUTSIDE the synced tree — CI deploys with `rsync --delete` and would
# otherwise wipe them. Cloudflare needs these for SSL mode "Full"/"Full (strict)";
# for "Full (strict)" use a Cloudflare Origin CA certificate.
EDGE_CERT_DIR=/home/kalanaliyanage22/omnichannel-certs
